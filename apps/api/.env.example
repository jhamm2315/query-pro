# Copy to .env and edit before starting the API server.

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
# Fast small models (recommended for <5s responses):
#   ollama pull qwen2.5-coder:1.5b   (~1.0B params, best for SQL, ~3s on CPU)
#   ollama pull llama3.2:1b          (~1.0B params, good for chat,  ~2s on CPU)
#   ollama pull llama3.2             (~3.2B params, best quality,   ~15s on CPU)
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_TIMEOUT=60
# Cap generation to keep responses fast. 700 covers plan+SQL comfortably.
OLLAMA_NUM_PREDICT=700
# Smaller context = faster prefill for long prompts.
OLLAMA_NUM_CTX=4096

# SQLite
DB_PATH=sql_copilot.db

# Voice backend: stub | whisper | vosk
VOICE_BACKEND=stub

# CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
